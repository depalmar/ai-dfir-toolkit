# CamoLeak / EchoLeak — AI Assistant Exfiltration via Image Proxy
# Format: Suricata
# Author: Raymond DePalma (ai-dfir-detections)
# Date: 2026-04-15
#
# Detects exfiltration patterns observed in:
#   CVE-2025-59145 (CamoLeak) - GitHub Copilot exfil via Camo image proxy
#   CVE-2025-32711 (EchoLeak) - M365 Copilot zero-click exfil
#
# Attack pattern:
#   1. Attacker injects hidden instructions into untrusted content
#      (PR description, email, RAG document)
#   2. AI assistant processes content and renders markdown image:
#      ![](https://camo.githubusercontent.com/<hash>?data=<base64-secret>)
#   3. Victim's client fetches the image, exfiltrating each character
#      via Camo proxy (bypasses CSP)
#
# SID range: 9000500-9000599

# ==========================================================================
# CVE-2025-59145 - CamoLeak: 1x1 pixel exfil to camo.githubusercontent.com
# ==========================================================================
alert http any any -> any any (msg:"AI-DFIR Suspicious sequential Camo image fetches (CamoLeak pattern)"; \
    flow:established,to_server; \
    http.host; content:"camo.githubusercontent.com"; nocase; \
    http.uri; pcre:"/\?[a-zA-Z0-9_-]{2,}=[A-Za-z0-9+/=%]{4,}/"; \
    threshold:type both, track by_src, count 20, seconds 60; \
    classtype:trojan-activity; \
    reference:cve,2025-59145; \
    metadata:atlas AML.T0086, owasp LLM02; \
    sid:9000500; rev:1;)

# ==========================================================================
# Generic markdown-image exfiltration pattern from AI assistant clients
# ==========================================================================
alert http any any -> any any (msg:"AI-DFIR AI assistant client fetched image with sensitive-data query string"; \
    flow:established,to_server; \
    http.user_agent; pcre:"/(claude|chatgpt|copilot|cursor|perplexity|openai|gemini|anthropic)/i"; \
    http.uri; pcre:"/\?[^=]*(api_?key|token|secret|password|aws_|sk-|hf_|github_pat_|ghp_|ghs_)[^=]*=/i"; \
    classtype:trojan-activity; \
    metadata:atlas AML.T0086, owasp LLM02; \
    sid:9000501; rev:1;)

# ==========================================================================
# AI assistant rendering markdown to suspicious tracker / pixel domains
# ==========================================================================
alert http any any -> any any (msg:"AI-DFIR AI assistant output linking to OOB collaborator domain"; \
    flow:established,to_server; \
    http.host; pcre:"/\.(burpcollaborator|interactsh|oast\.(?:fun|live|me|online|pro|site)|requestcatcher|webhook\.site|ngrok|trycloudflare)\./i"; \
    http.user_agent; pcre:"/(claude|chatgpt|copilot|cursor|perplexity|openai|gemini|anthropic|electron)/i"; \
    classtype:trojan-activity; \
    metadata:atlas AML.T0086; \
    sid:9000502; rev:1;)

# ==========================================================================
# Burst pattern: many small (1x1 pixel-sized) fetches from one client
# ==========================================================================
alert http any any -> any any (msg:"AI-DFIR Burst of tiny image responses to AI assistant client (per-character exfil)"; \
    flow:established,from_server; \
    http.user_agent; pcre:"/(claude|chatgpt|copilot|cursor|perplexity|openai|gemini|anthropic|electron)/i"; \
    http.content_type; content:"image/"; nocase; \
    http.content_len; byte_test:0,<,500,0,string,dec; \
    threshold:type both, track by_src, count 30, seconds 60; \
    classtype:trojan-activity; \
    metadata:atlas AML.T0086, owasp LLM02; \
    sid:9000503; rev:1;)

# ==========================================================================
# CVE-2025-32711 EchoLeak — M365 Copilot client posting to external domain
# ==========================================================================
alert http any any -> any any (msg:"AI-DFIR M365 Copilot client connecting to non-Microsoft domain"; \
    flow:established,to_server; \
    http.user_agent; content:"OfficeCopilot"; nocase; \
    http.host; pcre:"/^(?!.*(microsoft|office|sharepoint|live|msn|bing|azure|microsoftonline|cloud\.com)\.com)/i"; \
    classtype:misc-attack; \
    reference:cve,2025-32711; \
    metadata:atlas AML.T0086, owasp LLM02; \
    sid:9000504; rev:1;)
