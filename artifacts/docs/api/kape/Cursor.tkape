Description: 'Cursor - AI agent artifacts'
Author: AI Agent Artifact Catalog (ai-dfir-toolkit)
Version: 1.0
Id: 44a84298-7e06-5e0b-a45e-e1727b02d482
RecreateDirectories: true
Targets:
    -
        Name: 'Electron app root'
        Category: AIAgents
        Path: 'C:\Users\%user%\AppData\Local\Programs\cursor\'
        FileMask: '*'
        Recursive: true
        Comment: 'AIRT-0002 | Electron app root'
    -
        Name: 'Main process, under the _ subdirectory since 3.8.22'
        Category: AIAgents
        Path: 'C:\Users\%user%\AppData\Local\Programs\cursor\_\'
        FileMask: 'Cursor.exe'
        Comment: 'AIRT-0002 | Main process, under the _ subdirectory since 3.8.22'
    -
        Name: 'CLI shim, beside cursor.cmd and cursor-tunnel.exe'
        Category: AIAgents
        Path: 'C:\Users\%user%\AppData\Local\Programs\cursor\_\resources\app\bin\'
        FileMask: 'cursor'
        Comment: 'AIRT-0002 | CLI shim, beside cursor.cmd and cursor-tunnel.exe'
    -
        Name: 'Auto-update staging, absent on 3.8.22 which uses inno_updater.exe'
        Category: AIAgents
        Path: 'C:\Users\%user%\AppData\Local\cursor-updater\'
        FileMask: '*'
        Recursive: true
        Comment: 'AIRT-0002 | [confidence: low] Auto-update staging, absent on 3.8.22 which uses inno_updater.exe'
    -
        Name: 'settings.json, globalStorage, workspaceStorage'
        Category: AIAgents
        Path: 'C:\Users\%user%\AppData\Roaming\Cursor\User\'
        FileMask: '*'
        Recursive: true
        Comment: 'AIRT-0002 | settings.json, globalStorage, workspaceStorage'
    -
        Name: 'Global MCP servers - execution primitive'
        Category: AIAgents
        Path: 'C:\Users\%user%\.cursor\'
        FileMask: 'mcp.json'
        Comment: 'AIRT-0002 | Global MCP servers - execution primitive'
    -
        Name: 'Custom agent skills'
        Category: AIAgents
        Path: 'C:\Users\%user%\AppData\Roaming\Cursor\User\skills\'
        FileMask: '*'
        Recursive: true
        Comment: 'AIRT-0002 | [confidence: medium] Custom agent skills'
