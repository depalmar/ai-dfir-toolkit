RecreateDirectories: true
Targets:
    -
        Name: 'Config File for Goose'
        Category: AIAgents
        Path: 'C:\Users\%user%\AppData\Roaming\goose\'
        FileMask: 'config.yaml'
        Comment: 'AIRT-0038 | Config File for Goose'
    -
        Name: 'Records which tools were authorized - consent evidence'
        Category: AIAgents
        Path: 'C:\Users\%user%\.config\goose\permission.yaml ; permissions\'
        FileMask: 'tool_permissions.json'
        Comment: 'AIRT-0038 | Records which tools were authorized - consent evidence'
