Description: 'Codeium / Windsurf - AI agent artifacts'
Author: AI Agent Artifact Catalog (ai-dfir-toolkit)
Version: 1.0
Id: 68bd7ca7-a104-562e-ac01-958ec0f0c1e4
RecreateDirectories: true
Targets:
    -
        Name: 'API key + downloaded language server'
        Category: AIAgents
        Path: 'C:\Users\%user%\.codeium\'
        FileMask: '*'
        Recursive: true
        Comment: 'AIRT-0006 | API key + downloaded language server'
    -
        Name: 'Execution primitive'
        Category: AIAgents
        Path: 'C:\Users\%user%\.codeium\windsurf\'
        FileMask: 'mcp_config.json'
        Comment: 'AIRT-0006 | Execution primitive'
    -
        Name: 'Remote binary download - verify hash'
        Category: AIAgents
        Path: 'C:\Users\%user%\.codeium\*\'
        FileMask: 'language_server_*'
        Comment: 'AIRT-0006 | [confidence: medium] Remote binary download - verify hash'
    -
        Name: 'State directories for the next and insiders release channels, laid out like...'
        Category: AIAgents
        Path: 'C:\Users\%user%\.codeium\windsurf-next\'
        FileMask: '*'
        Recursive: true
        Comment: 'AIRT-0006 | State directories for the next and insiders release channels, laid out like ~/.codeium/windsurf/ with their own mcp_config.json and skills. A host on a pre-release channel has noth'
    -
        Name: 'State directories for the next and insiders release channels, laid out like...'
        Category: AIAgents
        Path: 'C:\Users\%user%\.codeium\windsurf-insiders\'
        FileMask: '*'
        Recursive: true
        Comment: 'AIRT-0006 | State directories for the next and insiders release channels, laid out like ~/.codeium/windsurf/ with their own mcp_config.json and skills. A host on a pre-release channel has noth'
