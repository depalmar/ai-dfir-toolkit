        Category: AIAgents
        Path: 'C:\Users\%user%\AppData\Roaming\com.LangflowDesktop\data\'
        FileMask: 'database.db'
        Comment: 'AIRT-0044 | Langflow: Langflow Desktop''s SQLite database on Windows, documented verbatim by the vendor as C:\Users\<name>\AppData\Roaming\com.LangflowDesktop\data\database.db. Same contents as'
