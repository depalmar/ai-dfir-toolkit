Description: 'Plaintext credential stores written by AI agents and LLM runtimes'
Author: AI Agent Artifact Catalog (ai-dfir-toolkit)
Version: 1.0
Id: 7beb6587-1241-5291-bd57-0a9c8433da6a
RecreateDirectories: true
Targets:
    -
        Name: 'Aider: OpenRouter OAuth (PKCE) tokens - plaintext'
        Category: AIAgents
        Path: 'C:\Users\%user%\.aider\'
        FileMask: 'oauth-keys.env'
        Comment: 'AIRT-0004 | Aider: OpenRouter OAuth (PKCE) tokens - plaintext'
    -
        Name: 'Amazon Q Developer (ex-CodeWhisperer): SSO access tokens - credential-theft...'
        Category: AIAgents
        Path: 'C:\Users\%user%\.aws\sso\cache\'
        FileMask: '*.json'
        Comment: 'AIRT-0008 | Amazon Q Developer (ex-CodeWhisperer): SSO access tokens - credential-theft target'
    -
        Name: 'Claude Code: Plaintext OAuth credential file. Mode 0600 on Linux; on...'
        Category: AIAgents
        Path: 'C:\Users\%user%\.claude\'
        FileMask: '.credentials.json'
        Comment: 'AIRT-0001 | Claude Code: Plaintext OAuth credential file. Mode 0600 on Linux; on Windows the path is %USERPROFILE%\.claude\.credentials.json and it inherits user-profile ACLs. Vendor-documente'
    -
        Name: 'Claude Code: Plaintext third-party secrets embedded in local- and...'
