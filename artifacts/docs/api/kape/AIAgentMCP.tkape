Description: 'MCP client/server configs - records what the agent was authorised to run'
Author: AI Agent Artifact Catalog (ai-dfir-toolkit)
Version: 1.0
Id: 8d432274-e8b1-5ce6-98ed-ff8678ae5b90
RecreateDirectories: true
Targets:
    -
        Name: 'Amazon Q Developer (ex-CodeWhisperer): mcpServers'
        Category: AIAgents
        Path: 'C:\Users\%user%\.aws\amazonq\'
        FileMask: 'mcp.json'
        Comment: 'AIRT-0008 | Amazon Q Developer (ex-CodeWhisperer): mcpServers'
    -
        Name: 'Amazon Q Developer (ex-CodeWhisperer): Agent configuration, global scope in the '
        Category: AIAgents
        Path: 'C:\Users\%user%\.aws\amazonq\'
        FileMask: 'default.json'
        Comment: 'AIRT-0008 | Amazon Q Developer (ex-CodeWhisperer): Agent configuration, global scope in the IDE'
    -
        Name: 'Claude Code: mcpServers (user scope)'
        Category: AIAgents
        Path: 'C:\Users\%user%\'
        FileMask: '.claude.json'
        Comment: 'AIRT-0001 | Claude Code: mcpServers (user scope)'
    -
        Name: 'Claude Desktop (MCP host): mcpServers.<name>.command + .args'
        Category: AIAgents
        Path: 'C:\Users\%user%\AppData\Roaming\Claude\'
        FileMask: 'claude_desktop_config.json'
        Comment: 'AIRT-0011 | Claude Desktop (MCP host): mcpServers.<name>.command + .args'
