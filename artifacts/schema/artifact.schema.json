{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/depalmar/ai-dfir-toolkit/blob/main/artifacts/schema/artifact.schema.json",
  "title": "AI Agent Artifact Catalog Entry",
  "description": "Forensic artifact profile for an AI agent, LLM runtime, or MCP component.",
  "type": "object",
  "required": [
    "id",
    "name",
    "vendor",
    "category",
    "description",
    "supported_os",
    "capabilities",
    "risk",
    "confidence",
    "artifacts",
    "collection",
    "last_modified"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^AIRT-[0-9]{4}$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vendor": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "coding-agent-cli",
        "coding-agent-ide",
        "code-completion",
        "mcp-host",
        "mcp-server",
        "agent-framework",
        "code-execution-agent",
        "llm-runtime",
        "workflow-engine",
        "browser-agent",
        "computer-use-agent",
        "cloud-agent",
        "other"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "legacy",
        "dormant",
        "unmaintained",
        "eol"
      ]
    },
    "supported_os": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "windows",
          "macos",
          "linux",
          "docker",
          "container",
          "cloud"
        ]
      }
    },
    "execution_model": {
      "type": "string"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_code_execution": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "local_listener": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "plaintext_credentials": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "mcp_capable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "browser_control": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "screen_capture": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "risk": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "abuse_potential": {
      "type": "string"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disk": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diskArtifact"
          }
        },
        "registry": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registryArtifact"
          }
        },
        "network": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/networkArtifact"
          }
        },
        "process": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processArtifact"
          }
        },
        "eventlog": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/eventlogArtifact"
          }
        }
      }
    },
    "credentials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/credential"
      }
    },
    "mcp": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mcpConfig"
      }
    },
    "collection": {
      "type": "object",
      "required": [
        "triage_priority"
      ],
      "additionalProperties": false,
      "properties": {
        "triage_priority": {
          "type": "string",
          "enum": [
            "p1",
            "p2",
            "p3"
          ]
        },
        "guidance": {
          "type": "string"
        },
        "kape_target": {
          "type": "string"
        },
        "velociraptor_artifact": {
          "type": "string"
        }
      }
    },
    "atlas_techniques": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AML\\.T[0-9]{4}(\\.[0-9]{3})?$"
      }
    },
    "attack_techniques": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "last_modified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "last_verified": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "When this entry was last checked against reality, as opposed to last edited. last_modified tracks edits; a typo fix moves it and verifies nothing. Left unset means never checked, which is a truthful state and is reported as such."
    }
  },
  "$defs": {
    "osList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "windows",
          "macos",
          "linux",
          "docker",
          "container",
          "cloud"
        ]
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "forensicValue": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "diskArtifact": {
      "type": "object",
      "required": [
        "path",
        "os",
        "artifact_type",
        "forensic_value",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "os": {
          "$ref": "#/$defs/osList"
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "binary",
            "install-dir",
            "config-file",
            "config-dir",
            "mcp-config",
            "rules-file",
            "agent-definition",
            "credential-file",
            "session-artifact",
            "log",
            "database",
            "data-dir",
            "env-var",
            "service-config",
            "extension-bundle",
            "container",
            "project-artifact"
          ],
          "description": "Controlled vocabulary. Adding a value means updating the schema, the template, and the skill together - an unconstrained field fragments the published CSV feed."
        },
        "description": {
          "type": "string"
        },
        "forensic_value": {
          "$ref": "#/$defs/forensicValue"
        },
        "evidence_type": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "execution",
              "persistence",
              "configuration",
              "credential-access",
              "user-activity",
              "data-access",
              "timeline",
              "program-presence",
              "prompt-injection-surface"
            ]
          }
        },
        "install_method": {
          "type": "string"
        },
        "unverified": {
          "type": "boolean",
          "description": "Set true when the artifact is single-source or otherwise not independently corroborated. Required to carry a low-confidence artifact inside a high-confidence entry."
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "registryArtifact": {
      "type": "object",
      "required": [
        "key",
        "description",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "persistence": {
          "type": "boolean"
        },
        "forensic_value": {
          "$ref": "#/$defs/forensicValue"
        },
        "unverified": {
          "type": "boolean",
          "description": "Set true when the artifact is single-source or otherwise not independently corroborated. Required to carry a low-confidence artifact inside a high-confidence entry."
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "networkArtifact": {
      "type": "object",
      "required": [
        "direction",
        "indicator",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "egress",
            "listener",
            "egress-(indirect)",
            "ingress-(loopback)"
          ]
        },
        "indicator": {
          "type": "string"
        },
        "port": {
          "type": "string"
        },
        "default_bind": {
          "type": "string"
        },
        "authentication": {
          "type": "string"
        },
        "exposure_risk": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "description": {
          "type": "string"
        },
        "unverified": {
          "type": "boolean"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "processArtifact": {
      "type": "object",
      "required": [
        "name",
        "os",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "os": {
          "$ref": "#/$defs/osList"
        },
        "typical_parent": {
          "type": "string"
        },
        "typical_children": {
          "type": "string"
        },
        "service_or_daemon": {
          "type": "string"
        },
        "persistence": {
          "type": "string"
        },
        "unverified": {
          "type": "boolean",
          "description": "Set true when the artifact is single-source or otherwise not independently corroborated. Required to carry a low-confidence artifact inside a high-confidence entry."
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "credential": {
      "type": "object",
      "required": [
        "location",
        "storage",
        "secret_type",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "location": {
          "type": "string"
        },
        "os": {
          "$ref": "#/$defs/osList"
        },
        "storage": {
          "type": "string",
          "enum": [
            "plaintext",
            "os-keyring",
            "encrypted",
            "sqlite",
            "unknown"
          ]
        },
        "secret_type": {
          "type": "string",
          "enum": [
            "api-key",
            "oauth-token",
            "jwt-signing-key",
            "session-state",
            "aws-sso-token",
            "admin-credential",
            "embedded-credentials",
            "encryption-key",
            "unknown"
          ]
        },
        "description": {
          "type": "string"
        },
        "unverified": {
          "type": "boolean",
          "description": "Set true when the artifact is single-source or otherwise not independently corroborated. Required to carry a low-confidence artifact inside a high-confidence entry."
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "mcpConfig": {
      "type": "object",
      "required": [
        "config_path",
        "triage_priority"
      ],
      "additionalProperties": false,
      "properties": {
        "config_path": {
          "type": "string"
        },
        "config_key": {
          "type": "string"
        },
        "spawn_mechanism": {
          "type": "string"
        },
        "secrets_location": {
          "type": "string"
        },
        "persistence_trigger": {
          "type": "string"
        },
        "triage_priority": {
          "type": "string",
          "enum": [
            "p1",
            "p2",
            "p3"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "eventlogArtifact": {
      "type": "object",
      "required": [
        "channel",
        "event_id",
        "description",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "channel": {
          "type": "string",
          "description": "Windows event log channel, e.g. Security or Microsoft-Windows-Sysmon/Operational."
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "description": "A single event ID. One row per ID rather than a list, so the published feed stays filterable."
        },
        "selector": {
          "type": "string",
          "description": "The field and value that narrow the channel to this tool, e.g. Image ends with ollama.exe. Without it the row names a log, not an artifact."
        },
        "description": {
          "type": "string"
        },
        "requires": {
          "type": "string",
          "description": "Any configuration the event depends on. These events do not exist by default: Sysmon must be deployed, and Security 4688 carries a command line only when command line auditing is enabled. A row without this reads as though the evidence is always there."
        },
        "evidence_type": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "execution",
              "persistence",
              "configuration",
              "credential-access",
              "user-activity",
              "data-access",
              "timeline",
              "program-presence",
              "prompt-injection-surface"
            ]
          }
        },
        "os": {
          "$ref": "#/$defs/osList"
        },
        "forensic_value": {
          "$ref": "#/$defs/forensicValue"
        },
        "unverified": {
          "type": "boolean",
          "description": "Set true when the artifact is single-source or otherwise not independently corroborated."
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    }
  }
}
